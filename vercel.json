{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/sw.js", "dest": "/frontend/sw.js" },
    { "src": "/manifest.json", "dest": "/frontend/manifest.json" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
